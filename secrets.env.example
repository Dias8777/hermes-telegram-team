# Copy to secrets.env (git-ignored) and fill in, then run scripts/install.sh.
# Leave COORDINATOR_BOT_TOKEN empty to keep the bot already configured in ~/.hermes/.env.
COORDINATOR_BOT_TOKEN=
RESEARCHER_BOT_TOKEN=
CODER_BOT_TOKEN=
# Your Telegram user id(s), comma-separated (ask @userinfobot). Only these humans can use the team.
TELEGRAM_ALLOWED_USERS=
# Optional: only needed for a fresh machine; otherwise the key is cloned from the default profile.
# Google AI Studio key (aistudio.google.com -> API keys), free tier is enough.
GEMINI_API_KEY=
